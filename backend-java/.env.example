# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/automapguard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long-for-hs256-algorithm
JWT_EXPIRATION=86400000

# Python Microservice Configuration
PYTHON_MICROSERVICE_URL=http://localhost:8081

# Server Configuration
SERVER_PORT=8080

# Logging
LOGGING_LEVEL=INFO

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
