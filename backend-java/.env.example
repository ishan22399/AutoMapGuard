# ============================================
# JAVA BACKEND CONFIGURATION (.env.example)
# TEMPLATE FILE - Replace with your actual values
# ============================================

# PostgreSQL Database (Supabase)
# Copy your actual credentials from Supabase dashboard
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-host.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password-here
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# JWT Configuration
# Generate a strong random string (at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-in-production
JWT_EXPIRATION=86400000

# Python Microservice Configuration
PYTHON_MICROSERVICE_URL=http://localhost:8081

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging
LOGGING_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
