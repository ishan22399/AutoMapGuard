# ============================================
# JAVA BACKEND CONFIGURATION (.env)
# ============================================

# PostgreSQL Database (Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.jtbbjzrwznchvouwkhve.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=ishan22399@
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5

# JWT Configuration
JWT_SECRET=automapguard-jwt-secret-key-minimum-32-characters-required-for-hs256
JWT_EXPIRATION=86400000

# Python Microservice Configuration
PYTHON_MICROSERVICE_URL=http://localhost:8081

# Server Configuration
SERVER_PORT=8080
ENVIRONMENT=development

# Spring Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging
LOGGING_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
