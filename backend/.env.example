# ============================================
# PYTHON BACKEND CONFIGURATION (.env.example)
# TEMPLATE FILE - Replace with your actual values
# ============================================

# Server Configuration
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8081
ENVIRONMENT=development

# Java Backend URL
JAVA_BACKEND_URL=http://localhost:8080

# PostgreSQL Database (Supabase)
# Copy your actual credentials from Supabase dashboard
POSTGRES_URL=postgresql://postgres:your-password@your-supabase-host.supabase.co:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password-here
POSTGRES_HOST=your-supabase-host.supabase.co
POSTGRES_PORT=5432

# MongoDB Atlas
# Get your connection string from MongoDB Atlas dashboard
MONGO_URL=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=automapguard

# Geometry Engine Settings
MIN_AREA_M2=20
MIN_EDGE_LENGTH_M=1
ANGLE_TOLERANCE_DEGREES=5
SIMPLIFICATION_TOLERANCE_M=0.5

# JWT Configuration (must match Java backend)
# Generate a strong random string (at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-in-production
JWT_ALGORITHM=HS256

# Logging Configuration
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
