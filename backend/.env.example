# Python Microservice Configuration

# Server
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8081
ENVIRONMENT=development

# Java Backend URL (for potential reverse calls)
JAVA_BACKEND_URL=http://localhost:8080

# PostgreSQL (if needed for PostGIS integration in future)
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/automapguard
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Geometry Engine Settings
MIN_AREA_M2=20
MIN_EDGE_LENGTH_M=1
ANGLE_TOLERANCE_DEGREES=5
SIMPLIFICATION_TOLERANCE_M=0.5

# Logging
LOG_LEVEL=INFO
